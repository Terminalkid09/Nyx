{
    "name":  "nyx-desktop",
    "version":  "1.0.0",  "description": "Nyx — Security Testing Suite",
  "homepage": "https://github.com/Terminalkid09/Nyx",
  "main": "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "pack":  "electron-builder --dir",
                    "dist":  "electron-builder",
                    "dist:win":  "electron-builder --win",
                    "dist:mac":  "electron-builder --mac",
                    "dist:linux":  "electron-builder --linux",
                    "build:collab":  "cd ../collaborator \u0026\u0026 go build -ldflags=\"-s -w\" -o ../dist/nyx-collaborator.exe .",
                    "build:backend":  "cd .. \u0026\u0026 pyinstaller --noconfirm desktop/nyx-backend.spec \u0026\u0026 cd desktop \u0026\u0026 npm run build:collab"
                },
"build":  {
                  "appId":  "com.nyx.desktop",
                  "productName":  "Nyx",
                  "directories":  {
                                  "output":  "dist"
                              },
                  "files":  [
                              "main.js",
                              "preload.js",
                              "browser.html",
                              "icon.*",
                              "package.json",
                              "node_modules/**/*",
                              "!node_modules/**/test/**",
                              "!node_modules/**/tests/**",
                              "!node_modules/.cache/**"
                          ],
                  "extraResources":  [
                                         {
                                             "from":  "../dist",
                                             "to":  "backend",
                                             "filter":  [
                                                            "nyx-backend*",
                                                            "nyx-collaborator*"
                                                        ]
                                         },
                                         {
                                             "from":  "../frontend/dist",
                                             "to":  "frontend",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ],
                              "icon":  "icon.ico",
                              "requestedExecutionLevel":  "requireAdministrator"
                          },
                  "mac":  {
                              "target":  [
                                             "dmg"
                                         ],
                              "icon":  "icon.png",
                              "category":  "public.app-category.developer-tools",
                              "hardenedRuntime":  true,
                              "gatekeeperAssess":  false
                          },
                  "linux":  {
                                "target":  [
                                               "AppImage",
                                               "deb"
                                           ],
                                "icon":  "icon.png",
                                "category":  "Development"
                            },    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
                           "installerIcon":  "icon.ico",
                           "uninstallerIcon":  "icon.ico",
                           "createDesktopShortcut":  true,
                           "createStartMenuShortcut":  true,
                           "deleteAppDataOnUninstall":  true,
                           "runAfterFinish":  false
                       },
                  "dmg":  {
                              "title":  "Nyx ${version}",
                              "icon":  "icon.png"
                          },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "Terminalkid09",
                                      "repo":  "nyx"
                                  }
                              ]
              },  "author": {
    "name": "Nyx Developer",
    "email": "Terminalkid09@users.noreply.github.com"
  },
    "license":  "ISC",
    "devDependencies":  {
                            "electron":  "^43.1.1",
                            "electron-builder":  "^26.15.3"
                        },
    "dependencies":  {
                         "electron-updater":  "^6.8.9"
                     }
}
