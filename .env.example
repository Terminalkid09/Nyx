# ─── Database ───────────────────────────────────────────
# PostgreSQL (recommended for production — avoids write-lock contention)
DATABASE_URL=postgresql+asyncpg://nyx:nyx@localhost:5432/nyx
# SQLite (dev only — single-user)
# DATABASE_URL=sqlite+aiosqlite:///nyx.db

# ─── Backend ────────────────────────────────────────────
# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_with_python_-c_"import_secrets;print(secrets.token_hex(32))"
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated extra Host header values the API accepts. Loopback hosts are
# always allowed; set this only if you reach the API through a real hostname.
# API_ALLOWED_HOSTS=nyx.internal,localhost
# Comma-separated CIDRs of a reverse proxy you control. Peers inside them may
# call the API without X-API-Key (the Docker stack sets 172.28.0.0/24).
# TRUSTED_PROXY_CIDRS=
# Bind the proxy on all interfaces so LAN devices (phones/tablets) can reach it
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
MAX_BODY_SIZE_BYTES=10485760
# How many captured requests to keep before the janitor deletes the oldest.
# MAX_STORED_REQUESTS=50000
# List of host regexes NEVER intercepted (OS connectivity/telemetry endpoints).
# Prevents the target device's captive-portal / "suspicious network" detection.
# Defaults cover Google/Apple/Microsoft/Android connectivity checks.
# PROXY_IGNORE_HOSTS=["^connectivitycheck\\.gstatic\\.com$"]

# ─── Storage / encryption ───────────────────────────────
# Where the SQLite DB, the API key and reports live (the desktop app sets this
# to its userData directory). Without it the DB sits in backend/ (dev only).
# NYX_HOME=
# Opt-in SQLCipher encryption at rest. Requires pysqlcipher3 (see README).
# Without it the SQLite file and captured bodies are PLAINTEXT.
# NYX_SQLCIPHER_KEY=

# ─── PostgreSQL (Docker) ────────────────────────────────
POSTGRES_USER=nyx
POSTGRES_PASSWORD=nyx
POSTGRES_DB=nyx

# ─── Collaborator (OAST) ────────────────────────────────
COLLAB_DOMAIN=oast.nyx.local
COLLAB_SECRET=change-me
COLLAB_HTTP_PORT=9999
COLLAB_API_PORT=9090
COLLAB_DNS_PORT=53
COLLAB_TTL_HOURS=24
COLLAB_WEBHOOK_URL=
