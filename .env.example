# Database (SQLite by default, PostgreSQL via DATABASE_URL)
DATABASE_URL=sqlite+aiosqlite:///nyx.db
# DATABASE_URL=postgresql+asyncpg://nyx:nyx@localhost:5432/nyx

# Backend
SECRET_KEY=generate_with_python_-c_import_secrets;print(secrets.token_hex(32))
DEBUG=false

# Collaborator (Go OAST server)
COLLAB_DOMAIN=oast.nyx.local
COLLAB_SECRET=change-me
COLLAB_HTTP_PORT=9999
COLLAB_DNS_PORT=53
COLLAB_API_PORT=9090
COLLAB_TTL_HOURS=24
COLLAB_WEBHOOK_URL=
